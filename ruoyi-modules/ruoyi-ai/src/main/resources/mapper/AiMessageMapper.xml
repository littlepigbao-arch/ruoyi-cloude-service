<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ai.mapper.AiMessageMapper">

    <resultMap type="com.ruoyi.ai.domain.AiMessage" id="AiMessageResult">
        <id     property="messageId"        column="message_id"/>
        <result property="conversationId"   column="conversation_id"/>
        <result property="role"             column="role"/>
        <result property="content"          column="content"/>
        <result property="actions"          column="actions"/>
        <result property="promptTokens"     column="prompt_tokens"/>
        <result property="completionTokens" column="completion_tokens"/>
        <result property="totalTokens"     column="total_tokens"/>
        <result property="model"           column="model"/>
        <result property="createBy"        column="create_by"/>
        <result property="createTime"      column="create_time"/>
    </resultMap>

    <sql id="insertColumn">
        conversation_id, role, content, actions, prompt_tokens, completion_tokens, total_tokens, model, create_by, create_time
    </sql>

    <insert id="insertMessage" parameterType="com.ruoyi.ai.domain.AiMessage" useGeneratedKeys="true" keyProperty="messageId">
        insert into ai_message (<include refid="insertColumn"/>)
        values (
            #{conversationId}, #{role}, #{content}, #{actions},
            #{promptTokens}, #{completionTokens}, #{totalTokens}, #{model},
            #{createBy}, sysdate()
        )
    </insert>

    <!-- 最近 N 条，按 message_id 升序返回（先 user 后 assistant 的对话顺序） -->
    <select id="selectRecentByConvId" resultMap="AiMessageResult">
        select * from (
            select message_id, conversation_id, role, content, actions,
                   prompt_tokens, completion_tokens, total_tokens, model,
                   create_by, create_time
            from ai_message
            where conversation_id = #{conversationId}
            order by message_id desc
            limit #{limit}
        ) t
        order by message_id asc
    </select>

</mapper>
